# Comma-separated list of frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: folder holding the downloaded QiandaoEar22 audio (see
# training/acoustics/README.md). Leave unset to use
# training/acoustics/data/qiandaoear22 in the repository. The app also runs
# without any audio; the spectrogram explorer then uses a synthetic signal.
# ACOUSTICS_DATA_DIR=
